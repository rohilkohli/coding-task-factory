  {
    "id": "infinity-prefix-only",
    "description": "Only 'Inf' is matched, so 'Infinity' leaves trailing characters",
    "edits": [{"file": "src/lib_json/json_reader.cpp",
               "old": "  case 'I':\n    if (features_.allowSpecialFloats_) {\n      token.type_ = tokenPosInf;\n      ok = match(\"nfinity\", 7);",
