  {
    "id": "offsets-not-recorded",
    "description": "NaN values do not record source offsets",
    "edits": [{"file": "src/lib_json/json_reader.cpp",
               "old": "  case tokenNaN: {\n    Value v(std::numeric_limits<double>::quiet_NaN());\n    currentValue().swapPayload(v);\n    currentValue().setOffsetStart(token.start_ - begin_);\n    currentValue().setOffsetLimit(token.end_ - begin_);",
               "new": "  case tokenNaN: {\n    Value v(std::numeric_limits<double>::quiet_NaN());\n    currentValue().swapPayload(v);"}]
