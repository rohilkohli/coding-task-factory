               "new": "  case tokenNaN: {\n    Value v;"}]
  },
  {
    "id": "negative-infinity-sign-lost",
    "description": "-Infinity decodes to +infinity",
    "edits": [{"file": "src/lib_json/json_reader.cpp",
               "old": "    Value v(-std::numeric_limits<double>::infinity());",
               "new": "    Value v(std::numeric_limits<double>::infinity());"}]
  },
  {
    "id": "plus-infinity-unsupported",
    "description": "+Infinity spelling not supported",
    "edits": [{"file": "src/lib_json/json_reader.cpp",
               "old": "  case '+':\n    if (readNumber(true)) {\n      token.type_ = tokenNumber;\n    } else {\n      token.type_ = tokenPosInf;\n      ok = features_.allowSpecialFloats_ && match(\"nfinity\", 7);\n    }\n    break;\n",
               "new": ""}]
  },
  {
    "id": "negative-infinity-unsupported",
    "description": "'-' always reads a number, so -Infinity is rejected",
    "edits": [{"file": "src/lib_json/json_reader.cpp",
               "old": "  case '-':\n    if (readNumber(true)) {\n      token.type_ = tokenNumber;\n    } else {\n      token.type_ = tokenNegInf;\n      ok = features_.allowSpecialFloats_ && match(\"nfinity\", 7);\n    }\n    break;\n",
               "new": "  case '-':\n    token.type_ = tokenNumber;\n    readNumber(false);\n    break;\n"}]
  },
  {
    "id": "infinity-check-off-by-one",
    "description": "Sign handling does not consume the 'I', so the rest of the token never matches",
    "edits": [{"file": "src/lib_json/json_reader.cpp",
               "old": "  if (checkInf && p != end_ && *p == 'I') {\n    current_ = ++p;",
               "new": "  if (checkInf && p != end_ && *p == 'I') {\n    current_ = p;"}]
  },
  {
    "id": "setting-ignored-always-on",
